# Copy this file to .env and fill in your own keys. Never commit .env.

# Free key: fred.stlouisfed.org -> My Account -> API Keys
FRED_API_KEY=

# LLM for the agents (llm.provider: openai_compatible in config.yaml): any OpenAI-style
# Chat Completions endpoint. Example: NVIDIA NIM (build.nvidia.com -> API key).
JFF_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
JFF_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
JFF_LLM_API_KEY=
JFF_LLM_TIMEOUT=120

# Only for llm.provider: anthropic
ANTHROPIC_API_KEY=
